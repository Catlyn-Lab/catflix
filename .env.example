# Catflix settings. Copy to `.env` and fill in. `.env` is never committed.
#
# VITE_* values are built into the web and desktop apps, so they are PUBLIC once shipped.
# Everything else stays on the server.

# ---- Sources (web, desktop and server) --------------------------------------------------------
# Catalogue and playback API hosts, comma-separated, tried in turn.
VITE_CATALOGUE_HOSTS=https://api-one.example,https://api-two.example
# Anime: the catalogue's JSON bridge, and the site itself (its filter page).
VITE_ANIME_BRIDGE=https://bridge.example/api/anime
VITE_ANIME_SITE=https://anime.example
# Asian drama: the WordPress site, and its playlist feeds ({id} = the post's player id).
VITE_DRAMA_SITE=https://drama.example
VITE_DRAMA_PLAYLISTS=https://feeds.example/{id}?alt=json
# Reader service for sources that refuse proxies (the source URL is appended).
VITE_READER_URL=https://reader.example/
# Video hosts that play directly, and the ones that only answer the referer below.
VITE_DIRECT_HOSTS=cdn-one.example,cdn-two.example
VITE_LOCKED_HOSTS=locked-cdn.example
VITE_LOCKED_REFERER=https://drama.example/

# ---- Catflix's own server ----------------------------------------------------------------------
# Where the apps reach the backend. Empty on the website itself means "this site".
VITE_BACKEND_URL=https://catflix.example
PORT=8110
PUBLIC_URL=https://catflix.example
DB_PATH=./data/catflix.db
# Other pages allowed to call the backend with credentials (desktop app, local development).
ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:1420
SESSION_DAYS=180

# Google sign-in: an OAuth client of type "Web application" whose redirect URI is
# ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Machine translation (descriptions and "Translator" subtitles), tried in order.
TRANSLATORS=google,mymemory
GOOGLE_TRANSLATE_URL=https://translate.googleapis.com/translate_a/t
MYMEMORY_URL=https://api.mymemory.translated.net/get
GUEST_SUBTITLE_JOBS_PER_HOUR=6

# AI subtitles: Anthropic (https://api.anthropic.com/v1/messages) or any OpenAI-compatible endpoint
# (…/v1). Called from the server only. Empty = AI option hidden. AI_PROVIDER: anthropic / openai
# (guessed from the URL when empty).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_CHARACTERS=200000
# Ceiling for all viewers together per day.
AI_GLOBAL_DAILY_CHARACTERS=2000000
# For reasoning models: none / low / medium (empty = don't send). Batches translated at once.
AI_REASONING_EFFORT=none
AI_CONCURRENCY=4

# ---- Asian drama subtitles -----------------------------------------------------------------------
# original: the drama's own subtitles. alternative: looked up on SubDL first, then OpenSubtitles
# (the drama's own only when neither finds any). Free keys: subdl.com/panel/api and
# opensubtitles.com/consumers. The account is optional and raises OpenSubtitles' download limit.
DRAMA_SUBTITLES=original
SUBDL_API_KEY=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
ALTERNATIVE_SUBTITLE_LANGUAGES=en,id
